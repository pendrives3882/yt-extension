{
  "manifest_version": 3,
  "name": "YT Video Downloader",
  "version": "1.0",
  "description": "Download YouTube videos easily",
  "permissions": [
    "activeTab",
    "tabs"
  ],
  "host_permissions": [
    "https://yt-url-extractor.onrender.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  }
}
